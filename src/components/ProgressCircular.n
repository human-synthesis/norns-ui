svg(
	class!="{classes}"
	width!="{px}"
	height!="{px}"
	viewBox!="0 0 {viewBox} {viewBox}"
	role="progressbar"
	aria-valuemin="0"
	aria-valuemax!="{max}"
	aria-valuenow!="{indeterminate ? undefined : value}"
)
	circle(
		cx!="{center}"
		cy!="{center}"
		r!="{radius}"
		stroke="var(--color-border)"
		stroke-width!="{stroke}"
		fill="none"
	)
	+if('arc > 0')
		circle(
			cx!="{center}"
			cy!="{center}"
			r!="{radius}"
			stroke="var(--color-primary-600)"
			stroke-width!="{stroke}"
			stroke-linecap="round"
			fill="none"
			stroke-dasharray!="{arc} {circumference - arc}"
			stroke-dashoffset!="{circumference / 4}"
		)

<script>
	import { cn } from '@human-synthesis/norns-ui/cn'

	{
		value = 0
		max = 100
		size = 'md'
		indeterminate = false
		class: extra = ''
	} := $props()

	px := size === 'sm' ? 24 : size === 'lg' ? 64 : 40
	stroke := size === 'sm' ? 3 : size === 'lg' ? 5 : 4
	viewBox := px
	center := px / 2
	radius := center - stroke
	circumference := $derived 2 * Math.PI * radius
	pct := $derived Math.max(0, Math.min(100, (value / max) * 100))
	// Arc length; the quarter-turn dash offset starts it at 12 o'clock, so no
	// rotate() is needed.
	arc := $derived indeterminate ? circumference * 0.3 : (circumference * pct) / 100
	classes := cn indeterminate && 'ui-spin', extra
</script>
