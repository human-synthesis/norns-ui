+if('trigger')
	span(class!="{triggerClass ?? ''}" onclick!="{() => open = true}")
		| {@render trigger()}

//- Native modal <dialog>: the browser makes the page inert, keeps focus inside,
//- handles Escape and paints it in the top layer. The backdrop is transparent.
+if('open')
	dialog(
		use:showModal
		use:scrollLock
		aria-label!="{title ?? ariaLabel}"
		class!="{contentClasses}"
		oncancel!="{onCancel}"
		onclick!="{onBackdropClick}"
	)
		+if('title')
			h2.dialog-title
				| {title}
		+if('description')
			p.dialog-description
				| {description}
		+if('children')
			.dialog-body
				| {@render children()}
		+if('actions')
			.dialog-actions
				| {@render actions()}
		+if('!hideClose')
			button.dialog-close(type="button" aria-label="Close" onclick!="{onClose}")
				Icon(name="lucide:x" size="size-3.5")

<script>
	import { cn } from '@human-synthesis/norns-ui/cn'
	import { scrollLock } from '@human-synthesis/norns-ui/behaviors/scrollLock.svelte.js'
	import Icon from './Icon.n'

	{
		open = $bindable(false)
		title
		description
		hideClose = false
		dismissable = true
		ariaLabel
		trigger
		actions
		children
		triggerClass
		class: extra = ''
	} .= $props()

	contentClasses := cn 'dialog-content', extra

	showModal := (node) => node.showModal()

	onClose := => open = false

	// Escape: let Svelte remove the dialog instead of the browser closing it.
	onCancel := (e) =>
		e.preventDefault()
		open = false if dismissable

	// A click on the transparent backdrop targets the <dialog> itself, outside
	// its box.
	onBackdropClick := (e) =>
		return unless dismissable && e.target === e.currentTarget
		r := e.currentTarget.getBoundingClientRect()
		outside := e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom
		open = false if outside
</script>
