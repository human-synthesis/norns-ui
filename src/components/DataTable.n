.data-table-wrap(class!="{wrapClasses}" aria-busy!="{loading ? 'true' : undefined}")
	table.data-table
		thead
			tr
				+each('columns as col')
					th(
						class!="{col.class ?? ''}"
						style!="{col.width ? `width: ${col.width}` : undefined}"
						aria-sort!="{sortKey === col.key ? (sortDir === 'asc' ? 'ascending' : 'descending') : undefined}"
					)
						+if('col.sortable')
							button.data-table-sort(type="button" onclick!="{() => onSort(col.key)}")
								span {col.label ?? col.key}
								Icon(name!="{sortIcon(col.key)}" size="size-3.5" class="text-fg-muted")
						+if('!col.sortable')
							| {col.label ?? col.key}
		tbody
			+if('rows.length === 0')
				tr.data-table-empty
					td(colspan!="{columns.length}")
						| {loading ? loadingMessage : emptyMessage}
			+each('rows as row, i')
				tr(onclick!="{onrowclick ? () => onrowclick(row, i) : undefined}" class!="{onrowclick ? 'data-table-row-clickable' : ''}")
					+each('columns as col')
						td(class!="{col.cellClass ?? ''}")
							| {col.format ? col.format(row[col.key], row) : row[col.key]}

<script>
	import { cn } from '@human-synthesis/norns-ui/cn'
	import Icon from './Icon.n'

	{
		columns = []
		rows = []
		striped = false
		dense = false
		stickyHeader = false
		loading = false
		emptyMessage = 'No data'
		loadingMessage = 'Loading…'
		sortKey = $bindable(undefined)
		sortDir = $bindable('asc')
		onrowclick
		class: extra = ''
	} .= $props()

	wrapClasses := $derived cn
		'data-table-root'
		striped && 'data-table-striped'
		dense && 'data-table-dense'
		stickyHeader && 'data-table-sticky'
		loading && 'data-table-loading'
		extra

	// Sorting is delegated: the component only flips `sortKey` / `sortDir`
	// (both bindable). Sort the `rows` yourself, or hand both bindings to
	// `useList()` and let the server order the page.
	onSort := (key) =>
		if sortKey === key
			sortDir = sortDir === 'asc' ? 'desc' : 'asc'
		else
			sortKey = key
			sortDir = 'asc'

	sortIcon := (key) =>
		return 'lucide:chevrons-up-down' unless sortKey === key
		sortDir === 'asc' ? 'lucide:chevron-up' : 'lucide:chevron-down'
</script>
