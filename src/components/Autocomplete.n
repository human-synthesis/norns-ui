.combobox-input-wrap(use:refAction bind:this!="{wrapEl}")
	input.input.combobox-input(
		bind:this!="{inputEl}"
		type="text"
		bind:value!="{term}"
		placeholder!="{placeholder}"
		disabled!="{disabled}"
		role="combobox"
		aria-expanded!="{open}"
		aria-controls!="{listboxId}"
		aria-autocomplete="list"
		aria-busy!="{loading ? 'true' : undefined}"
		aria-activedescendant!="{open && filtered[active] ? optionId(active) : undefined}"
		id!="{resolvedId}"
		aria-invalid!="{hasError ? 'true' : undefined}"
		oninput!="{onInput}"
		onkeydown!="{onKeyDown}"
		onfocus!="{() => open = true}"
		onblur!="{onBlur}"
	)
	button.combobox-trigger(type="button" tabindex="-1" aria-label="Toggle options" onclick!="{toggle}")
		Icon(name!="{loading ? 'lucide:loader-circle' : 'lucide:chevrons-up-down'}" size="size-4" class!="{loading ? 'ui-spin' : ''}")

+if('open && filtered.length > 0')
	ul(
		use:portal
		use:floatAction
		use:clickOutside!="{[onClose, open, wrapEl]}"
		class="dropdown-content combobox-listbox"
		data-state="open"
		id!="{listboxId}"
		role="listbox"
	)
		+each('filtered as item, i (item.value)')
			li.dropdown-item(
				role="option"
				id!="{optionId(i)}"
				aria-selected!="{value === item.value}"
				data-active!="{i === active ? 'true' : undefined}"
				onpointerdown!="{(e) => { e.preventDefault(); pick(item) }}"
			)
				Icon(name="lucide:check" size="size-3.5" class!="{value === item.value ? '' : 'combobox-check-hidden'}")
				span {item.label}
+if('open && filtered.length === 0 && (loading || term.length >= minChars)')
	div(use:portal use:floatAction use:clickOutside!="{[onClose, open, wrapEl]}" class="dropdown-content combobox-listbox" data-state="open")
		.combobox-empty {loading ? loadingMessage : emptyMessage}

<script>
	import { getContext } from 'svelte'
	import Icon from './Icon.n'
	import { portal } from '@human-synthesis/norns-ui/behaviors/portal.svelte.js'
	import { clickOutside } from '@human-synthesis/norns-ui/behaviors/clickOutside.svelte.js'
	import { useFloating } from '@human-synthesis/norns-ui/behaviors/floating.svelte.js'

	{
		items = []
		source
		debounce = 200
		minChars = 0
		value = $bindable(undefined)
		open = $bindable(false)
		placeholder = 'Search…'
		emptyMessage = 'No matches'
		loadingMessage = 'Searching…'
		disabled = false
		name
		id: providedId
		error: explicitError = false
	} .= $props()

	field := getContext 'norns-ui:field'
	resolvedId := providedId ?? field?.id
	hasError := explicitError || field?.hasError || false

	uid := Math.random().toString(36).slice(2, 8)
	listboxId := `listbox-${uid}`
	optionId := (i) => `option-${uid}-${i}`

	{ reference: refAction, floating: floatAction, update: updateFloat } := useFloating
		placement: 'bottom-start'
		offset: 4
		matchWidth: true

	term .= $state ''
	active .= $state 0
	inputEl .= $state null
	wrapEl .= $state null

	// Remote mode: `source(term)` resolves the options for the current input.
	// Results are debounced, out-of-order responses are dropped, and the
	// picked item is remembered so its label survives a new search.
	remote .= $state []
	loading .= $state false
	picked .= $state null
	seq .= 0

	all := $derived source ? remote : items

	search := async (t) =>
		id := ++seq
		loading = true
		try
			res := await source t
			return unless id === seq
			remote = Array.isArray(res) ? res : (res?.data ?? [])
		catch
			remote = [] if id === seq
		finally
			loading = false if id === seq

	$effect =>
		return unless source && open
		t := term
		return if t.length < minChars
		timer := setTimeout (=> search t), debounce
		return () => clearTimeout timer

	// Reset term to selected label when value changes externally.
	$effect =>
		if value !== undefined
			match := all.find((it) => it.value === value) ?? (picked?.value === value ? picked : null)
			term = match?.label ?? '' if match && term !== match.label

	filtered := $derived.by =>
		return remote if source
		return items unless term
		t := term.toLowerCase()
		items.filter (it) => it.label.toLowerCase().includes(t)

	// The list changed size (typing, remote results): re-place it once.
	$effect =>
		filtered.length
		updateFloat() if open
		return

	$effect =>
		active = 0 if active >= filtered.length

	onInput := =>
		open = true
		active = 0

	toggle := =>
		open = !open
		inputEl?.focus() if open

	onClose := => open = false

	onBlur := =>
		// Close after click handlers complete; pointerdown picks before this fires.
		setTimeout (=> open = false), 100

	pick := (item) =>
		picked = item
		value = item.value
		term = item.label
		open = false

	onKeyDown := (e) =>
		switch e.key
			when 'ArrowDown'
				e.preventDefault()
				open = true
				active = Math.min(filtered.length - 1, active + 1)
			when 'ArrowUp'
				e.preventDefault()
				open = true
				active = Math.max(0, active - 1)
			when 'Enter'
				if open && filtered[active]
					e.preventDefault()
					pick filtered[active]
			when 'Escape'
				open = false
			when 'Tab'
				open = false
</script>
