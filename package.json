{
	"name": "@human-synthesis/norns-ui",
	"version": "0.0.18",
	"description": "UI library for the Norns ecosystem — Pug + Civet components on Tailwind v4.",
	"license": "MIT",
	"author": "Daniel Teodoroiu (https://humansynthesis.ai)",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/human-synthesis/norns-ui.git"
	},
	"files": [
		"src",
		"README.md",
		"COMPONENTS.md"
	],
	"scripts": {
		"test": "bun test",
		"check:shims": "bun scripts/check-shims.mjs",
		"check:shims:strict": "bun scripts/check-shims.mjs --strict",
		"docs:components": "bun scripts/gen-components-doc.mjs",
		"docs:components:check": "bun scripts/gen-components-doc.mjs --check"
	},
	"exports": {
		".": "./src/index.js",
		"./auto-import": "./src/auto-import.js",
		"./cn": "./src/lib/cn.js",
		"./behaviors": "./src/lib/behaviors/index.js",
		"./behaviors/*": "./src/lib/behaviors/*",
		"./toast": "./src/lib/toast.svelte.js",
		"./list": "./src/lib/list.svelte.js",
		"./styles": "./src/styles/index.css",
		"./styles/tokens": "./src/styles/tokens.css",
		"./styles/atoms": "./src/styles/atoms.css",
		"./components/*": "./src/components/*",
		"./package.json": "./package.json"
	},
	"peerDependencies": {
		"@human-synthesis/norns": "^0.0.19",
		"@human-synthesis/norns-core": "^0.0.11",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@human-synthesis/norns": {
			"optional": false
		},
		"@human-synthesis/norns-core": {
			"optional": false
		}
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"@fontsource-variable/outfit": "^5.2.8",
		"@iconify-json/lucide": "^1.2.105",
		"@iconify/svelte": "^5.2.1",
		"tailwind-merge": "^2.5.0"
	},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	}
}
